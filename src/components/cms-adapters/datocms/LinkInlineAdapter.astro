---
import { getI18n } from "@i18n/microcopy";

const { node } = Astro.props;
const { url, meta } = node;

const lang = Astro.locals.lang || "it";
const t = getI18n(lang);

const target = meta?.find((m: any) => m.id === "target")?.value;

const isExternal = target === "_blank";
const finalLabel = isExternal ? t["link.external"] : t["link.internal"];
---

{
  /* Niente whitespace dentro l'anchor: verrebbe renderizzato (sottolineato)
  prima/dopo il testo del link e staccherebbe la punteggiatura successiva. */
}
<a
  href={url}
  target={target}
  rel={isExternal ? "noopener noreferrer" : undefined}
  ><slot /><span class="visually-hidden"> {finalLabel}</span></a
>
